# =============================================
# IP Centrum — Environment Configuration
# Copy to .env and fill in real values
# =============================================

# --- Application ---
NODE_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

# --- API Server ---
API_PORT=3000
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_EXPIRES_IN=8h

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://ipcentrum:password@localhost:5432/ipcentrum_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# --- Redis (Event Bus & Queue) ---
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# --- Anthropic AI ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_STANDARD=claude-sonnet-4-20250514
ANTHROPIC_MODEL_COMPLEX=claude-opus-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# --- EPO OPS API (Open Patent Services) ---
EPO_OPS_KEY=your-epo-ops-consumer-key
EPO_OPS_SECRET=your-epo-ops-consumer-secret
EPO_OPS_BASE_URL=https://ops.epo.org/3.2/rest-services

# --- UPC Registry ---
UPC_REGISTRY_BASE_URL=https://www.unified-patent-court.org
UPC_OPT_OUT_API_URL=https://www.epo.org/en/applying/european/unitary/opt-out

# --- Vector Database (Pinecone) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_REGULATORY=ip-centrum-regulatory
PINECONE_INDEX_PATENTS=ip-centrum-patents

# --- Email / Notifications ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@ip-centrum.com
EMAIL_FROM_NAME=IP Centrum Platform

# --- Slack Alerts (Internal) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL_ALERTS=#ip-centrum-alerts
SLACK_CHANNEL_CRITICAL=#ip-centrum-critical

# --- Monitoring (LangSmith) ---
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=ip-centrum-production
LANGSMITH_TRACING=true

# --- CRM Integration ---
CRM_API_URL=https://your-crm.com/api/v1
CRM_API_KEY=your-crm-api-key

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Feature Flags ---
FEATURE_UP_PATHWAY=true
FEATURE_AUTO_COMMS=false
FEATURE_BIZ_SIGNAL=true

# --- Governance ---
HUMAN_GATE_TIMEOUT_HOURS_CRITICAL=2
HUMAN_GATE_TIMEOUT_HOURS_STANDARD=4
HUMAN_GATE_TIMEOUT_HOURS_ADVISORY=48
AUDIT_LOG_RETENTION_YEARS=7
