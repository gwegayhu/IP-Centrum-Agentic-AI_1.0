# ─── Stage 1: Builder ───
FROM node:20-alpine AS builder

RUN npm install -g pnpm@9

WORKDIR /app

# Copy manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/database/package.json packages/database/
COPY packages/event-bus/package.json packages/event-bus/
COPY packages/agents/orchestrator/package.json packages/agents/orchestrator/
COPY packages/agents/doc-intel/package.json packages/agents/doc-intel/
COPY packages/agents/case-health/package.json packages/agents/case-health/
COPY packages/agents/reg-watch/package.json packages/agents/reg-watch/
COPY packages/agents/trans-orch/package.json packages/agents/trans-orch/
COPY packages/agents/agent-net/package.json packages/agents/agent-net/
COPY packages/agents/client-comms/package.json packages/agents/client-comms/
COPY packages/agents/quote-advisor/package.json packages/agents/quote-advisor/
COPY packages/agents/renew-intel/package.json packages/agents/renew-intel/
COPY packages/agents/data-verify/package.json packages/agents/data-verify/
COPY packages/agents/biz-signal/package.json packages/agents/biz-signal/
COPY apps/api/package.json apps/api/

RUN pnpm install --no-frozen-lockfile

# Copy source
COPY packages/ packages/
COPY apps/api/ apps/api/
COPY tsconfig.json ./

# Build
RUN pnpm --filter @ip-centrum/shared build
RUN pnpm --filter @ip-centrum/database build
RUN pnpm --filter @ip-centrum/event-bus build
RUN pnpm --filter @ip-centrum/agent-orchestrator build
RUN pnpm --filter @ip-centrum/api build

# ─── Stage 2: Production image ───
FROM node:20-alpine AS production

RUN npm install -g pnpm@9
RUN addgroup -g 1001 -S nodejs && adduser -S ipcentrum -u 1001

WORKDIR /app

COPY --from=builder --chown=ipcentrum:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=ipcentrum:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=ipcentrum:nodejs /app/packages ./packages

USER ipcentrum

EXPOSE 3000

ENV NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["node", "apps/api/dist/server.js"]
